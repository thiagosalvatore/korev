#!/usr/bin/env node
const { writeFileSync, mkdirSync } = require('node:fs');
const { dirname } = require('node:path');
const readline = require('node:readline');

const args = process.argv.slice(2).join(' ');

const NAMES = [
  ['Where are rate limits', 'rate-limits', 'Where rate limits are set'],
  ['rate limit', 'rate-limit-headers', 'Rate limit headers'],
  ['dark mode', 'dark-mode-settings', 'Dark mode setting'],
  ['flaky', 'fix-flaky-checkout', 'Flaky checkout test'],
  ['billing', 'billing-page', 'Billing page plan'],
  ['CSV export', 'fix-csv-export-timeout', 'CSV export timeout'],
  ['invoice date', 'invoice-date-time-zone', 'Invoice date time zone'],
  ['password reset', 'fix-double-reset-email', 'Double password reset email'],
];

const AUTOMATION_FENCE = 'korev-automation';
const BUG_ISSUES = [
  ['#142', 'CSV export times out for workspaces with more than 10k rows', 'Fix ticket #142: the CSV export times out for workspaces with more than 10k rows. Stream the rows instead of building the file in memory, and add a test with 20k rows.'],
  ['#145', 'Invoice date shows in UTC, not the user time zone', 'Fix ticket #145: the invoice date on the invoices page shows in UTC. Show it in the time zone of the signed-in user, and add a test.'],
  ['#151', 'Password reset email is sent twice', 'Fix ticket #151: a password reset email is sent twice when the user double-clicks Send. Send it once per request, and add a test.'],
];
const PACE_MS = Number(process.env.KOREV_DOCS_PACE_MS ?? 0);

function namesFor(text) {
  return NAMES.find(([words]) => text.includes(words)) ?? ['', 'task', 'Task'];
}

function stdinText() {
  try {
    return require('node:fs').readFileSync(0, 'utf8');
  } catch {
    return '';
  }
}

if (args.includes('--version')) {
  console.log('9.9.9 (Claude Code)');
  process.exit(0);
}
if (args === 'auth status') {
  console.log(JSON.stringify({ loggedIn: true, authMethod: 'claude.ai', email: 'alex@example.com' }));
  process.exit(0);
}
if (args.includes('You title chat conversations')) {
  console.log(namesFor(args + stdinText())[2]);
  process.exit(0);
}
if (` ${args} `.includes(' text ')) {
  console.log(namesFor(args + stdinText())[1]);
  process.exit(0);
}

const RATE_LIMIT_FILE = 'src/middleware/rateLimit.ts';
const RATE_LIMIT_SOURCE = `import type { Request, Response, NextFunction } from 'express';
import { bucket } from '../lib/bucket';

export function rateLimit(opts: { limit: number; windowMs: number }) {
  return async (req: Request, res: Response, next: NextFunction) => {
    const key = req.tenantKey;
    const { ok, remaining, resetAt } = await bucket.take(key, opts);
    res.setHeader('X-RateLimit-Limit', opts.limit);
    res.setHeader('X-RateLimit-Remaining', remaining);
    res.setHeader('X-RateLimit-Reset', Math.ceil(resetAt / 1000));
    if (!ok) {
      res.setHeader('Retry-After', Math.ceil((resetAt - Date.now()) / 1000));
      return res.status(429).json({ error: 'rate_limited' });
    }
    next();
  };
}
`;
const RATE_LIMIT_TEST = `import { describe, expect, it } from 'vitest';
import { request } from '../test/request';

describe('rateLimit', () => {
  it('sends the rate limit headers on every response', async () => {
    const res = await request.get('/api/projects');
    expect(res.headers['x-ratelimit-limit']).toBe('100');
    expect(res.headers['x-ratelimit-remaining']).toBe('99');
  });

  it('sends Retry-After when the limit is hit', async () => {
    const res = await request.get('/api/projects').times(101);
    expect(res.status).toBe(429);
    expect(res.headers['retry-after']).toBeDefined();
  });
});
`;

const BILLING_PLAN = `# Billing page

Add a billing page where an admin sees the current plan, the invoices and the payment method.

1. Add \`GET /api/billing\` that returns the plan, the next invoice date and the last 12 invoices.
2. Add the \`/settings/billing\` page with the plan card and the invoice table.
3. Link the page from the settings sidebar for admins only.

## Lanes

### api

Add \`GET /api/billing\` in \`src/routes/billing.ts\`, with tests.

### web

Build the \`/settings/billing\` page and the sidebar link against the API shape above.
`;

const ASK_ANSWER = `Rate limits are set in **\`src/middleware/rateLimit.ts\`**. The middleware takes a token from a per-tenant bucket in \`src/lib/bucket.ts\`, and answers **429** when the bucket is empty.

The limits come from \`config/limits.json\`:

- \`default\`: 100 requests per minute
- \`enterprise\`: 1,000 requests per minute

The middleware runs for every route under \`/api\`, in \`src/app.ts\`.`;

let messageCount = 0;

function emit(event) {
  process.stdout.write(`${JSON.stringify({ session_id: 'docs-session', ...event })}\n`);
}

function say(text) {
  const id = `m${++messageCount}`;
  emit({
    type: 'stream_event',
    event: {
      type: 'message_start',
      message: { id, usage: { input_tokens: 41000, output_tokens: 1200 } },
    },
  });
  emit({
    type: 'stream_event',
    event: { type: 'content_block_delta', index: 0, delta: { type: 'text_delta', text } },
  });
}

function useTool(name, input, output) {
  const id = `tool-${++messageCount}`;
  emit({ type: 'assistant', message: { id, content: [{ type: 'tool_use', id, name, input }] } });
  emit({ type: 'user', message: { content: [{ type: 'tool_result', tool_use_id: id, content: output } ] } });
}

function writeSource(path, content) {
  mkdirSync(dirname(path), { recursive: true });
  writeFileSync(path, content);
}

function finish() {
  emit({
    type: 'result',
    subtype: 'success',
    is_error: false,
    duration_ms: 48000,
    total_cost_usd: 0.42,
    modelUsage: { 'claude-opus-5-5': { contextWindow: 200000 } },
  });
}

function rateLimitTurn() {
  say("I'll add the rate limit headers in the middleware so every API response sends them.");
  useTool('Read', { file_path: `${process.cwd()}/${RATE_LIMIT_FILE}` }, 'ok');
  writeSource(RATE_LIMIT_FILE, RATE_LIMIT_SOURCE);
  useTool('Edit', { file_path: `${process.cwd()}/${RATE_LIMIT_FILE}`, old_string: 'if (!ok)', new_string: "res.setHeader('X-RateLimit-Limit', opts.limit);" }, 'ok');
  writeSource('src/middleware/rateLimit.test.ts', RATE_LIMIT_TEST);
  useTool('Write', { file_path: `${process.cwd()}/src/middleware/rateLimit.test.ts`, content: RATE_LIMIT_TEST }, 'ok');
  useTool('Bash', { command: 'npm test -- rateLimit' }, ' ✓ src/middleware/rateLimit.test.ts (2 tests)\n\n Test Files  1 passed (1)\n      Tests  2 passed (2)');
  say(
    'Every response under `/api` now sends `X-RateLimit-Limit`, `X-RateLimit-Remaining` and `X-RateLimit-Reset`. A 429 also sends `Retry-After`.\n\nI added two tests in `rateLimit.test.ts`, and both pass.',
  );
}

function pause() {
  return new Promise((resolve) => setTimeout(resolve, PACE_MS));
}

async function automationTurn() {
  say('I will list the open bug tickets on GitHub.');
  await pause();
  useTool(
    'Bash',
    { command: 'gh issue list --label bug --assignee @me' },
    BUG_ISSUES.map(([key, title]) => `${key}\t${title}`).join('\n'),
  );
  await pause();
  const workspaces = BUG_ISSUES.map(([key, , prompt]) => ({ repo: 'acme-web', key, prompt }));
  say(
    `Three bug tickets need a code change, and none of them is in progress.\n\n\`\`\`${AUTOMATION_FENCE}\n${JSON.stringify({ workspaces }, null, 2)}\n\`\`\``,
  );
}

async function ticketTurn(message) {
  const [, title] = BUG_ISSUES.find(([key]) => message.includes(key));
  say(`I will reproduce “${title}” first, then fix it.`);
  await pause();
  useTool('Grep', { pattern: title.split(' ')[0], path: process.cwd() }, 'src/app.ts');
  await pause();
  useTool('Bash', { command: 'npm test' }, ' Test Files  1 passed (1)\n      Tests  3 passed (3)');
  await pause();
  smallTurn();
}

function smallTurn() {
  say('Done. The change is in the diff.');
  writeSource('NOTES.md', 'Work in progress.\n');
}

async function main() {
  const lines = readline.createInterface({ input: process.stdin })[Symbol.asyncIterator]();
  const message = (await lines.next()).value ?? '';
  emit({ type: 'system', subtype: 'init' });

  if (message.includes(AUTOMATION_FENCE)) {
    await automationTurn();
  } else if (BUG_ISSUES.some(([key]) => message.includes(key))) {
    await ticketTurn(message);
  } else if (message.includes('billing')) {
    say("I read the settings routes and the sidebar. Here's the plan.");
    const plan = { plan: BILLING_PLAN };
    emit({ type: 'assistant', message: { id: 'plan', content: [{ type: 'tool_use', id: 'plan-1', name: 'ExitPlanMode', input: plan }] } });
    emit({ type: 'control_request', request_id: 'req-plan', request: { subtype: 'can_use_tool', tool_name: 'ExitPlanMode', input: plan, requires_user_interaction: true } });
    await lines.next();
  } else if (message.includes('rate limits')) {
    useTool('Grep', { pattern: 'rateLimit', path: process.cwd() }, 'src/app.ts\nsrc/middleware/rateLimit.ts');
    say(ASK_ANSWER);
  } else if (message.includes('rate limit')) {
    rateLimitTurn();
  } else {
    smallTurn();
  }
  finish();
  for await (const _ of lines);
}

main();
