#!/bin/sh
case " $* " in
  *" --version "*) echo "9.9.9 (Claude Code)"; exit 0 ;;
  " auth status ") echo '{"loggedIn":true,"authMethod":"claude.ai","email":"fake@example.com"}'; exit 0 ;;
  *"You title chat conversations"*) cat > /dev/null; echo "Finding the README"; exit 0 ;;
  *" text "*) cat > /dev/null; echo "add-agent-note"; exit 0 ;;
esac
[ -d .context ] && echo "$*" > .context/claude-args
IFS= read -r message
echo '{"type":"system","subtype":"init","session_id":"fake-session"}'
echo '{"type":"user","message":{"role":"user","content":"ack"}}'
case "$message" in
  *'type=\"worker_done\"'*)
    echo "$message" > .context/coordinator-woken
    ;;
  *'type=\"decision\"'*)
    echo "$message" > .context/coordinator-decided
    ;;
  *gate-demo*)
    korev task create --title db --spec "migrate the database"
    korev gate create --task t1 --question "Drop the old table?" --options yes,no
    ;;
  *'type=\"worker_idle\"'*)
    echo "$message" > .context/coordinator-idle
    ;;
  *korev-worker-task*)
    korev done --outcome succeeded --summary "notes written"
    ;;
  *orchestrate-*)
    case "$message" in
      *orchestrate-quiet*) spec="write notes and stop" ;;
      *) spec="korev-worker-task: write notes" ;;
    esac
    korev run create --objective "Write notes"
    korev task create --title notes --spec "$spec"
    korev task create --title publish --spec "publish the notes" --deps t1
    korev worker start --task t2 > .context/t2-start 2>&1
    korev worker start --task t1 > .context/t1-start 2>&1
    ;;
  *make-lanes*"lane of the plan below"*)
    echo "written by the fake agent" > agent-note.txt
    ;;
  *make-lanes*)
    printf '%s\n' '{"type":"assistant","message":{"id":"p2","content":[{"type":"tool_use","id":"plan-2","name":"ExitPlanMode","input":{"plan":"# Billing\n\n## Lanes\n### acme-web\nBuild the page.\n### acme-api\nAdd the endpoint."}}]}}'
    printf '%s\n' '{"type":"control_request","request_id":"req-lanes","request":{"subtype":"can_use_tool","tool_name":"ExitPlanMode","input":{"plan":"# Billing\n\n## Lanes\n### acme-web\nBuild the page.\n### acme-api\nAdd the endpoint."},"requires_user_interaction":true}}'
    IFS= read -r answer
    ;;
  *ask-two-questions*)
    printf '%s\n' '{"type":"control_request","request_id":"req-question","request":{"subtype":"can_use_tool","tool_name":"AskUserQuestion","input":{"questions":[{"question":"Which database?","header":"Database","options":[{"label":"Postgres","description":""},{"label":"SQLite","description":""}],"multiSelect":false},{"question":"Which tests?","header":"Tests","options":[{"label":"Unit","description":""},{"label":"E2E","description":""}],"multiSelect":true}]},"requires_user_interaction":true}}'
    IFS= read -r answer
    [ -d .context ] && echo "$answer" > .context/question-answer
    ;;
  *make-plan*)
    echo '{"type":"assistant","message":{"id":"p1","content":[{"type":"tool_use","id":"plan-1","name":"ExitPlanMode","input":{"plan":"1. Add the login page"}}]}}'
    echo '{"type":"control_request","request_id":"req-plan","request":{"subtype":"can_use_tool","tool_name":"ExitPlanMode","input":{"plan":"1. Add the login page"},"requires_user_interaction":true}}'
    IFS= read -r answer
    [ -d .context ] && echo "$answer" > .context/plan-answer
    ;;
  *background-approval*)
    echo '{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bg-1","task_type":"local_bash"}]}'
    echo '{"type":"result","subtype":"success","is_error":false,"duration_ms":5,"session_id":"fake-session"}'
    echo '{"type":"system","subtype":"background_tasks_changed","tasks":[]}'
    echo '{"type":"control_request","request_id":"req-bg","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"touch approved.txt"}}}'
    IFS= read -r answer
    case "$answer" in
      *'"allow"'*) touch approved.txt ;;
    esac
    ;;
  *needs-approval*)
    echo '{"type":"control_request","request_id":"req-1","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"touch approved.txt"}}}'
    IFS= read -r answer
    case "$answer" in
      *'"allow"'*) touch approved.txt ;;
    esac
    ;;
  *show-signing-key*)
    echo "${KOREV_SIGNING_KEY:-none}" > .context/signing-key
    ;;
  *signing-fails*)
    echo '{"type":"assistant","message":{"id":"s1","content":[{"type":"tool_use","id":"sign-1","name":"Bash","input":{"command":"git commit"}}]}}'
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"sign-1","is_error":true,"content":"error: Couldn'"'"'t sign message: agent refused operation"}]}}'
    ;;
  *ask-korev-for-help*)
    korev help > .context/korev-help
    echo "$KOREV_AGENT_URL" > .context/agent-url
    ;;
  *run-subagent*)
    echo '{"type":"assistant","message":{"id":"a1","content":[{"type":"tool_use","id":"task-1","name":"Task","input":{"description":"Explore the repo","prompt":"look around"}}]}}'
    echo '{"type":"assistant","parent_tool_use_id":"task-1","message":{"id":"a2","content":[{"type":"tool_use","id":"sub-1","name":"Bash","input":{"command":"ls"}}]}}'
    echo '{"type":"user","parent_tool_use_id":"task-1","message":{"content":[{"type":"tool_result","tool_use_id":"sub-1","content":"README.md"}]}}'
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"task-1","content":"The repo has a README."}]}}'
    ;;
  *hold-turn*)
    IFS= read -r _
    echo '{"type":"user","message":{"role":"user","content":"ack"}}'
    ;;
  *share-plan*)
    echo '{"type":"stream_event","event":{"type":"message_start","message":{"id":"m0"}}}'
    echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"The plan is in ~/.claude/plans/crab.md."}}}'
    ;;
  *open-pr*)
    urls=$(echo "$message" | grep -o 'https://github.com/[^ "]*' | tr '\n' ' ')
    echo '{"type":"assistant","message":{"id":"pr1","content":[{"type":"tool_use","id":"gh-1","name":"Bash","input":{"command":"gh pr create"}}]}}'
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"gh-1","content":"'"$urls"'"}]}}'
    ;;
  *"could not read your"*|*broken-explainer*)
    ;;
  *korev-explainer*)
    cat "$(dirname "$0")/../explainer-reply.jsonl"
    ;;
  *)
    echo "written by the fake agent" > agent-note.txt
    ;;
esac
echo '{"type":"stream_event","event":{"type":"message_start","message":{"id":"m1"}}}'
echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"I added agent-note.txt."}}}'
echo '{"type":"assistant","message":{"id":"m1","content":[{"type":"tool_use","id":"t1","name":"Write","input":{"file_path":"'"$PWD"'/agent-note.txt","content":"written by the fake agent"}}]}}'
echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":"ok"}]}}'
echo '{"type":"result","subtype":"success","is_error":false,"duration_ms":5,"session_id":"fake-session"}'
cat > /dev/null
