#!/usr/bin/env node
const { readFileSync } = require('node:fs');

const args = process.argv.slice(2);
if (args[0] === '--version') {
  process.stdout.write('2.1.288 (Claude Code)\n');
  process.exit(0);
}
if (args[0] === 'auth') {
  process.stdout.write(JSON.stringify({ loggedIn: true, subscriptionType: 'max' }));
  process.exit(0);
}

const prompt = readFileSync(0, 'utf8');
const base = { changed: false, commitMessage: null, questions: [] };

function event(content) {
  process.stdout.write(
    `${JSON.stringify({ type: 'assistant', message: { content } })}\n`,
  );
}

function reply(structured) {
  event([
    { type: 'text', text: 'Reading the change first.' },
    { type: 'tool_use', name: 'Read', input: { file_path: 'ingest.ts' } },
  ]);
  process.stdout.write(
    JSON.stringify({ type: 'result', result: '', structured_output: structured }),
  );
}

if (prompt.includes("Korev's explain agent")) {
  reply({
    ...base,
    summary: 'Limits ingestion per tenant',
    document:
      '<h2>What changes</h2><p>Each tenant gets its own ingestion rate limit.</p>',
  });
} else if (prompt.includes("Korev's review agent")) {
  reply({
    ...base,
    summary: 'One change worth making before merge.',
    event: 'COMMENT',
    comments: [
      {
        path: 'ingest.ts',
        line: 1,
        body: 'Read the limit from config instead of hard-coding it.',
        severity: 'medium',
        confidence: 'high',
      },
    ],
  });
} else if (prompt.includes("Korev's merge-conflict agent")) {
  if (prompt.includes('The user already answered')) {
    require('node:fs').writeFileSync('ingest.ts', 'export const limit = 75;\n');
    reply({ ...base, changed: true, summary: 'Set the limit to 75' });
  } else {
    reply({
      ...base,
      summary: 'One conflict needs a decision',
      questions: [
        {
          id: 'limit',
          question: 'Which ingestion limit should win?',
          context: 'ingest.ts: 100 on this PR, 50 on main',
        },
      ],
    });
  }
} else {
  process.stdout.write(
    JSON.stringify({ type: 'result', is_error: true, result: 'Unknown task' }),
  );
}
