#!/bin/sh
case " $* " in
  *" --version "*) echo "9.9.9 (Claude Code)"; exit 0 ;;
  " auth status ") echo '{"loggedIn":true,"authMethod":"claude.ai","email":"fake@example.com"}'; exit 0 ;;
  *"You title chat conversations"*) cat > /dev/null; echo "Finding the README"; exit 0 ;;
  *" text "*) cat > /dev/null; echo "add-agent-note"; exit 0 ;;
esac
[ -d .context ] && echo "$*" > .context/claude-args
IFS= read -r message
echo '{"type":"system","subtype":"init","session_id":"fake-session"}'
echo '{"type":"user","message":{"role":"user","content":"ack"}}'
case "$message" in
  *make-plan*)
    echo '{"type":"assistant","message":{"id":"p1","content":[{"type":"tool_use","id":"plan-1","name":"ExitPlanMode","input":{"plan":"1. Add the login page"}}]}}'
    echo '{"type":"control_request","request_id":"req-plan","request":{"subtype":"can_use_tool","tool_name":"ExitPlanMode","input":{"plan":"1. Add the login page"},"requires_user_interaction":true}}'
    IFS= read -r answer
    [ -d .context ] && echo "$answer" > .context/plan-answer
    ;;
  *background-approval*)
    echo '{"type":"system","subtype":"background_tasks_changed","tasks":[{"task_id":"bg-1","task_type":"local_bash"}]}'
    echo '{"type":"result","subtype":"success","is_error":false,"duration_ms":5,"session_id":"fake-session"}'
    echo '{"type":"system","subtype":"background_tasks_changed","tasks":[]}'
    echo '{"type":"control_request","request_id":"req-bg","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"touch approved.txt"}}}'
    IFS= read -r answer
    case "$answer" in
      *'"allow"'*) touch approved.txt ;;
    esac
    ;;
  *needs-approval*)
    echo '{"type":"control_request","request_id":"req-1","request":{"subtype":"can_use_tool","tool_name":"Bash","input":{"command":"touch approved.txt"}}}'
    IFS= read -r answer
    case "$answer" in
      *'"allow"'*) touch approved.txt ;;
    esac
    ;;
  *hold-turn*)
    IFS= read -r _
    ;;
  *share-plan*)
    echo '{"type":"stream_event","event":{"type":"message_start","message":{"id":"m0"}}}'
    echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"The plan is in ~/.claude/plans/crab.md."}}}'
    ;;
  *open-pr*)
    urls=$(echo "$message" | grep -o 'https://github.com/[^ "]*' | tr '\n' ' ')
    echo '{"type":"assistant","message":{"id":"pr1","content":[{"type":"tool_use","id":"gh-1","name":"Bash","input":{"command":"gh pr create"}}]}}'
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"gh-1","content":"'"$urls"'"}]}}'
    ;;
  *)
    echo "written by the fake agent" > agent-note.txt
    ;;
esac
echo '{"type":"stream_event","event":{"type":"message_start","message":{"id":"m1"}}}'
echo '{"type":"stream_event","event":{"type":"content_block_delta","index":0,"delta":{"type":"text_delta","text":"I added agent-note.txt."}}}'
echo '{"type":"assistant","message":{"id":"m1","content":[{"type":"tool_use","id":"t1","name":"Write","input":{"file_path":"'"$PWD"'/agent-note.txt","content":"written by the fake agent"}}]}}'
echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":"ok"}]}}'
echo '{"type":"result","subtype":"success","is_error":false,"duration_ms":5,"session_id":"fake-session"}'
cat > /dev/null
