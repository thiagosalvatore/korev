#!/usr/bin/env node
const { readFileSync } = require('node:fs');

const args = process.argv.slice(2);
if (args[0] === '--version') {
  process.stdout.write('2.1.288 (Claude Code)\n');
  process.exit(0);
}
if (args[0] === 'auth') {
  process.stdout.write(JSON.stringify({ loggedIn: true, subscriptionType: 'max' }));
  process.exit(0);
}

const prompt = readFileSync(0, 'utf8');
const base = { changed: false, commitMessage: null, questions: [] };

function reply(structured) {
  process.stdout.write(
    JSON.stringify({ type: 'result', result: '', structured_output: structured }),
  );
}

if (prompt.includes("Korev's explain agent")) {
  reply({
    ...base,
    summary: 'Limits ingestion per tenant',
    document:
      '<h2>What changes</h2><p>Each tenant gets its own ingestion rate limit.</p>',
  });
} else {
  process.stdout.write(JSON.stringify({ is_error: true, result: 'Unknown task' }));
}
